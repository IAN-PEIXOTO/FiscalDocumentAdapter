<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fiscaladapter</groupId>
    <artifactId>fiscal-document-adapter</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>fiscal-document-adapter</name>
    <description>Adapter fiscal gratuito: recebe JSON e emite documentos fiscais eletronicos diretamente na SEFAZ, sem ACBr</description>

    <properties>
        <java.version>21</java.version>
        <!-- FIS-41: teste de carga (tag JUnit5 "carga") fica fora do `mvn verify` padrao -
             sobrescrever com -Dsurefire.excludedGroups= (vazio) para incluir. -->
        <surefire.excludedGroups>carga</surefire.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-authorization-server</artifactId>
            <version>1.3.2</version>
        </dependency>
        <dependency>
            <!-- Documentacao interativa da API (FIS-35): expoe /v3/api-docs e /swagger-ui.html
                 gerados a partir das anotacoes/records dos controllers e DTOs existentes. -->
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Manipulacao de certificado PKCS#12 (A1). Assinatura XML-DSig usa
             javax.xml.crypto.dsig (JSR-105, nativo do JDK) e geracao/validacao
             de XML usa XMLStreamWriter + javax.xml.validation (tambem nativos) -
             ver "Bibliotecas e ferramentas de apoio (FIS-22)" no README para o
             porque de nao usarmos JAXB/xjc nem Apache Santuario aqui. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- Geracao de PDF (DANFE) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.42</version>
        </dependency>

        <!-- Geracao de QR Code (DANFE NFC-e, FIS-47) - OpenPDF so tem codigos de barra 1D
             (Code128 etc.), nao 2D. ZXing e a biblioteca de referencia (Apache 2.0, mesma
             usada pela imensa maioria das implementacoes de referencia de NFC-e). -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Banco de dados: H2 em memoria em dev/teste (application.yml), Postgres
             em homolog/producao (application-homolog.yml/application-prod.yml -
             FIS-26/32). As duas dependencias de banco convivem porque o profile
             ativo decide qual datasource e realmente usado em runtime. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Popula /actuator/info (build.version etc.) a partir do pom.xml -
                             versao da aplicacao (FIS-27), sem precisar duplicar manualmente
                             o numero de versao em application.yml. -->
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito/Byte Buddy ainda nao suportam oficialmente o Java 25 (so ate 23);
                         o modo experimental permite instrumentar classes mesmo assim. -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    <!-- Teste de carga (FIS-41, tag "carga") e mais lento e menos deterministico
                         (mede tempo de parede) que a suite normal - fica fora do `mvn verify`
                         padrao, rodar explicitamente com -Dgroups=carga. -->
                    <!-- Teste de carga (FIS-41, tag "carga") e mais lento e menos deterministico
                         (mede tempo de parede) que a suite normal - fica fora do `mvn verify`
                         padrao. Rodar explicitamente com:
                         ./mvnw test -Dsurefire.excludedGroups= -Dtest=NfeEmissaoCargaTest -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
